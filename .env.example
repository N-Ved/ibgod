# Copy this file to .env and adjust it for your deployment.
# The library and FileBrowser data are mounted read-only.
TZ=UTC
IBGOD_LIBRARY_PATH=./library
IBGOD_DATA_PATH=./data
IBGOD_FILEBROWSER_DATA_PATH=./filebrowser-data

# The app expects an authenticated reverse proxy to pass these headers.
IBGOD_TRUSTED_PROXY_HOSTS=caddy
IBGOD_PUBLIC_HOSTS=planner.example.com
IBGOD_ADMIN_GROUPS=admins
IBGOD_ADMIN_USERS=admin

# Optional integrations. Leave blank when they are not configured.
IBGOD_VIEW_BASE=
IBGOD_DOCS_BASE=
IBGOD_LOGOUT_URL=/logout

# Set this to the name of an existing proxy network when integrating with
# another Compose project.
IBGOD_NETWORK_NAME=ibgod
IBGOD_EXTERNAL_NETWORK=false
